# Copie para .env e preencha com os valores reais. O .env nunca vai para o repositório.

# Alias SSH do Eee PC (definido no ~/.ssh/config do PC de desenvolvimento)
DASHAMP_HOST_ALVO=eeepc

# SSID da rede Wi-Fi de casa (usado pela sincronização de viagens, F3.7)
DASHAMP_SSID_CASA=MinhaRedeExemplo

# Endereço do servidor de viagens (F3.6)
DASHAMP_SERVIDOR_URL=https://viagens.exemplo.invalid

# Token de acesso à API do servidor
DASHAMP_SERVIDOR_TOKEN=troque-por-um-token-secreto
